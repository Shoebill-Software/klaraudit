---
import { copyFor, githubUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = copyFor(lang);
const dockerCommand = 'docker run --rm --init --ipc=host ghcr.io/shoebill-software/klaraudit scan https://example.com';
---

<section id="license" class="scroll-mt-16 border-b border-slate-300">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-slate-500">
      {copy.pricing.eyebrow}
    </p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">
      {copy.pricing.title}
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
      {copy.pricing.lead}
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        copy.pricing.includes.map((item) => (
          <li class="border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700">
            {item}
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-slate-900 bg-slate-900 px-3 py-2 text-[#faf9f5] hover:bg-slate-800"
      >
        {copy.pricing.ctaGithub}
      </a>
      <a
        href="https://www.npmjs.com/package/klaraudit"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-slate-300 px-3 py-2 text-slate-800 hover:border-slate-900 hover:text-slate-900"
      >
        {copy.pricing.ctaNpm}
      </a>
    </div>

    <div class="mt-8 space-y-3">
      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-slate-500">
        {copy.pricing.commandsLabel}
      </p>
      <pre class="overflow-x-auto border border-slate-300 bg-[#faf9f5] px-4 py-3 font-mono text-xs text-slate-800"><code>{copy.pricing.npxCommand}</code></pre>
      <pre class="overflow-x-auto border border-slate-300 bg-[#faf9f5] px-4 py-3 font-mono text-xs text-slate-800"><code>{copy.pricing.jsonCommand}</code></pre>
      <pre class="overflow-x-auto border border-slate-300 bg-[#faf9f5] px-4 py-3 font-mono text-xs text-slate-800"><code>{dockerCommand}</code></pre>
    </div>

    <p class="mt-4 max-w-2xl text-xs leading-relaxed text-slate-500">
      {copy.pricing.footnote}
    </p>
  </div>
</section>
