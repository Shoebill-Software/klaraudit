<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>KlarAudit Compliance Report — {{targetUrl}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Segoe UI', 'Helvetica Neue', 'Arial', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            mono: ['Cascadia Code', 'ui-monospace', 'SFMono-Regular', 'Consolas', 'monospace'],
          },
        },
      },
    };
  </script>
  <style>
    @page {
      size: A4;
      margin: 15mm;
    }

    html, body {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .card,
    .metric-card,
    .finding-block,
    .score-card,
    table,
    tr {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .score-ring-progress {
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
  </style>
</head>
<body class="bg-white text-slate-900 font-sans text-[10.5pt] leading-relaxed antialiased">
  <header class="card mb-6 flex items-start justify-between gap-6 border-b-[3px] border-slate-900 pb-5">
    <div class="min-w-0">
      <div class="mb-3 flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-slate-900 text-sm font-bold tracking-tight text-white">
          KA
        </div>
        <div>
          <p class="m-0 text-[10px] font-bold uppercase tracking-[0.22em] text-slate-900">KlarAudit</p>
          <p class="m-0 text-[10px] uppercase tracking-[0.14em] text-slate-500">External EU privacy scan</p>
        </div>
      </div>
      <h1 class="m-0 text-[22px] font-semibold tracking-tight text-slate-900">
        KlarAudit Compliance Report
      </h1>
      <p class="mt-2 mb-0 break-all font-mono text-[11px] text-slate-600">{{targetUrl}}</p>
      <p class="mt-1 mb-0 text-[11px] text-slate-500">Scan date: {{formatDate scanDate}}</p>
    </div>
    <div class="shrink-0 text-right">
      <span class="inline-block rounded-full border px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] {{statusPillClass status}}">
        {{status}}
      </span>
      <p class="mt-2 mb-0 text-[10px] uppercase tracking-[0.12em] text-slate-400">Compliance status</p>
    </div>
  </header>

  <section class="score-card mb-6 rounded-xl border border-slate-200 bg-slate-50 px-5 py-5">
    <p class="m-0 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">01 — Executive score card</p>
    <div class="mt-4 flex items-center gap-8">
      <div class="relative h-32 w-32 shrink-0">
        <svg class="h-32 w-32" viewBox="0 0 120 120" role="img" aria-label="Compliance score {{score}} out of 100">
          <circle cx="60" cy="60" r="52" fill="none" stroke="#e2e8f0" stroke-width="8"></circle>
          <circle
            class="score-ring-progress {{scoreColorClass score}}"
            cx="60"
            cy="60"
            r="52"
            fill="none"
            stroke="currentColor"
            stroke-width="8"
            stroke-linecap="round"
            stroke-dasharray="326.73"
            stroke-dashoffset="{{scoreDashOffset}}"
          ></circle>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span class="text-4xl font-bold leading-none tracking-tight {{scoreColorClass score}}">{{score}}</span>
          <span class="mt-1 text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-400">/ 100</span>
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <h2 class="m-0 text-base font-semibold text-slate-900">Composite compliance score</h2>
        <p class="mt-1 mb-4 text-[12px] text-slate-600">
          Weighted 0–100 score from pre-consent trackers, third-party transfers, first-layer consent UX, and mandatory legal disclosures.
        </p>
        <div class="grid grid-cols-4 gap-2">
          <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-center">
            <p class="m-0 text-xl font-bold text-red-700">{{severityCounts.critical}}</p>
            <p class="m-0 text-[9px] font-bold uppercase tracking-[0.12em] text-red-800">Critical</p>
          </div>
          <div class="rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-center">
            <p class="m-0 text-xl font-bold text-orange-700">{{severityCounts.high}}</p>
            <p class="m-0 text-[9px] font-bold uppercase tracking-[0.12em] text-orange-800">High</p>
          </div>
          <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-center">
            <p class="m-0 text-xl font-bold text-amber-700">{{severityCounts.medium}}</p>
            <p class="m-0 text-[9px] font-bold uppercase tracking-[0.12em] text-amber-800">Medium</p>
          </div>
          <div class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-center">
            <p class="m-0 text-xl font-bold text-sky-700">{{severityCounts.low}}</p>
            <p class="m-0 text-[9px] font-bold uppercase tracking-[0.12em] text-sky-800">Low</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-6">
    <p class="m-0 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">02 — Summary metrics</p>
    <div class="mt-3 grid grid-cols-4 gap-3">
      <article class="metric-card rounded-lg border border-slate-200 bg-white px-4 py-3">
        <p class="m-0 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Total Requests</p>
        <p class="mt-1 mb-0 text-2xl font-semibold text-slate-900">{{metrics.totalRequests}}</p>
        <p class="mt-1 mb-0 text-[10px] text-slate-500">Network calls during the interaction-free load</p>
      </article>
      <article class="metric-card rounded-lg border border-slate-200 bg-white px-4 py-3">
        <p class="m-0 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Pre-Consent Cookies</p>
        <p class="mt-1 mb-0 text-2xl font-semibold {{#if metrics.cookiesSetBeforeConsent}}text-red-600{{else}}text-emerald-700{{/if}}">
          {{metrics.cookiesSetBeforeConsent}}
        </p>
        <p class="mt-1 mb-0 text-[10px] text-slate-500">Persistent non-essential cookies before any click</p>
      </article>
      <article class="metric-card rounded-lg border border-slate-200 bg-white px-4 py-3">
        <p class="m-0 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Third-Party Trackers</p>
        <p class="mt-1 mb-0 text-2xl font-semibold text-slate-900">{{metrics.thirdPartyRequests}}</p>
        <p class="mt-1 mb-0 text-[10px] text-slate-500">Outbound requests to domains other than the host</p>
      </article>
      <article class="metric-card rounded-lg border border-slate-200 bg-white px-4 py-3">
        <p class="m-0 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Non-EU Data Transfers</p>
        <p class="mt-1 mb-0 text-2xl font-semibold {{#if metrics.nonEuTransfers}}text-red-600{{else}}text-emerald-700{{/if}}">
          {{metrics.nonEuTransfers}}
        </p>
        <p class="mt-1 mb-0 text-[10px] text-slate-500">Distinct requests resolved outside the EU/EEA</p>
      </article>
    </div>
  </section>

  <section class="mb-6">
    <p class="m-0 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">03 — Audit findings</p>
    <h2 class="mt-2 mb-3 text-base font-semibold text-slate-900">Issues detected during the scan</h2>

    {{#if violations.length}}
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-slate-300 text-[9px] font-bold uppercase tracking-[0.12em] text-slate-500">
            <th class="py-2 pr-2 font-bold">Severity</th>
            <th class="py-2 pr-2 font-bold">Category</th>
            <th class="py-2 pr-2 font-bold">Issue</th>
            <th class="py-2 pr-2 font-bold">Deduction</th>
            <th class="py-2 font-bold">Resource</th>
          </tr>
        </thead>
        {{#each violations}}
          <tbody class="finding-block border-b border-slate-200">
            <tr>
              <td class="py-3 pr-2 align-top">
                <span class="inline-block rounded-full border px-2 py-0.5 text-[8px] font-bold uppercase tracking-[0.12em] {{severityBadgeClass severity}}">
                  {{severity}}
                </span>
              </td>
              <td class="py-3 pr-2 align-top font-mono text-[10px] text-slate-600">{{category}}</td>
              <td class="py-3 pr-2 align-top">
                <p class="m-0 text-[11px] font-semibold text-slate-900">{{ruleName}}</p>
                <p class="mt-1 mb-0 text-[11px] text-slate-700">{{message}}</p>
              </td>
              <td class="py-3 pr-2 align-top font-mono text-[11px] font-semibold text-red-700">{{formatDeduction deduction}}</td>
              <td class="py-3 align-top break-all font-mono text-[10px] text-slate-700">{{resource}}</td>
            </tr>
            <tr>
              <td colspan="5" class="pb-3">
                <div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2">
                  <p class="m-0 mb-1 text-[9px] font-bold uppercase tracking-[0.12em] text-amber-800">Remediation</p>
                  <p class="m-0 text-[11px] text-amber-950">{{recommendation}}</p>
                </div>
              </td>
            </tr>
          </tbody>
        {{/each}}
      </table>
    {{else}}
      <div class="card rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
        No violations were detected. This external, interaction-free scan did not observe pre-consent trackers,
        prohibited transfers, missing first-layer reject controls, or absent mandatory legal pages under the
        heuristics in scope.
      </div>
    {{/if}}
  </section>

  <footer class="mt-8 border-t border-slate-200 pt-4 text-[9px] leading-relaxed text-slate-500">
    <p class="m-0 font-semibold uppercase tracking-[0.14em] text-slate-400">Legal disclaimer</p>
    <p class="mt-2 mb-0 text-[11px] text-slate-600">
      This report is a technical assessment from an external regulator's vantage point. It evaluates publicly
      observable behaviour against Directive 2002/58/EC (e-Privacy Directive), GDPR Article 5(3), and the Court of
      Justice of the European Union judgment in Schrems II (C-311/18). Findings are heuristic observations from an
      unauthenticated, interaction-free page load. <strong class="font-semibold text-slate-700">This document does not replace formal legal counsel</strong>, a legal opinion, a Data Protection Impact Assessment, or certification
      of GDPR, e-Privacy, or Schrems II compliance.
    </p>
    <p class="mt-2 mb-0">
      Generated locally by KlarAudit {{engineVersion}} on {{generatedAt}}. No scan payload is transmitted to KlarAudit
      or any third-party cloud service. Format: A4 · Mode: unauthenticated external scan.
    </p>
  </footer>
</body>
</html>
